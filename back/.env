# Porta da API
PORT=3001

# Conexão com o PostgreSQL (mesmo banco criado no pgAdmin)
# formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres:admin123@localhost:5432/Save%20All

# Chave usada para assinar os tokens de login. Use um texto longo e aleatório.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=797786d17a99b03d9173b61e42b795396fccc4648ac8ff9b9a49a395ddd3c96fc864645e72de1d146c83a12ea15ff35f
JWT_EXPIRES=7d

# Chave que criptografa o certificado digital (senha e arquivo .pfx) no banco.
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GUARDE EM LOCAL SEGURO: se perder ou trocar a chave, os certificados já salvos ficam ilegíveis.
CHAVE_CRIPTOGRAFIA=DWbU1ueprQFBHYg6/5tYKwlgRhy1QzE/uCuK0KV0OE4=

# Endereço(s) do front autorizados a chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:9000

# Taxa de entrega cobrada nos pedidos (R$)
TAXA_ENTREGA=10
